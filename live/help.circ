      <a name="format" val="wrapped"/>
      <a name="style" val="p-margin: 0px;"/>
      <a name="text" val="any of the four devices can drive the bus wire to 1, or even more than one of them at the same time"/>
      <a name="textwidth" val="216"/>
      <a name="valign" val="base"/>
    </comp>
