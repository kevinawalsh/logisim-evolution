<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="5.1.1-HC" version="1.0">
  This file is intended to be loaded by Logisim-evolution (https://github.com/kevinawalsh/logisim-evolution).

  <lib desc="#Base" name="0">
    <tool name="Text Tool">
      <a name="background" val="#ffffff00"/>
      <a name="font" val="SansSerif plain 12"/>
      <a name="foreground" val="#000000"/>
      <a name="format" val="plain"/>
      <a name="halign" val="left"/>
      <a name="style" val=""/>
      <a name="text" val="text"/>
      <a name="valign" val="top"/>
    </tool>
  </lib>
  <lib desc="#Wiring" name="1">
    <tool name="Constant">
      <a name="value" val="0x1"/>
    </tool>
  </lib>
  <lib desc="#Gates" name="2"/>
  <lib desc="#Plexers" name="3">
    <tool name="Multiplexer">
      <a name="enable" val="false"/>
    </tool>
    <tool name="Demultiplexer">
      <a name="enable" val="false"/>
    </tool>
  </lib>
  <lib desc="#Arithmetic" name="4"/>
  <lib desc="#Memory" name="5">
    <tool name="ROM">
      <a name="contents">addr/data: 8 8
0
</a>
    </tool>
  </lib>
  <lib desc="#I/O" name="6">
    <tool name="RGB Video">
      <a name="fixed" val="0#888 RGB (24 bit)"/>
    </tool>
  </lib>
  <lib desc="#Analog" name="7"/>
  <lib desc="#Audio" name="8"/>
  <lib desc="#BFH-Praktika" name="9"/>
  <lib desc="#External I/O" name="10"/>
  <lib desc="#Decor" name="11"/>
  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
    <a name="simsmooth" val="50"/>
  </options>
  <mappings>
    <tool lib="0" map="Button2" name="Menu Tool"/>
    <tool lib="0" map="Button3" name="Menu Tool"/>
    <tool lib="0" map="Ctrl Button1" name="Menu Tool"/>
  </mappings>
  <toolbar>
    <tool lib="0" name="Poke Tool"/>
    <tool lib="0" name="Edit Tool"/>
    <tool lib="0" name="Wiring Tool"/>
    <tool lib="0" name="Cutter Tool"/>
    <tool lib="0" name="Text Tool">
      <a name="background" val="#ffffff00"/>
      <a name="font" val="SansSerif plain 12"/>
      <a name="foreground" val="#000000"/>
      <a name="format" val="plain"/>
      <a name="halign" val="left"/>
      <a name="style" val=""/>
      <a name="text" val="text"/>
      <a name="valign" val="top"/>
    </tool>
    <tool lib="11" name="Callout"/>
    <tool lib="11" name="Image"/>
    <sep/>
    <tool lib="1" name="Pin"/>
    <tool lib="1" name="Pin">
      <a name="facing" val="west"/>
      <a name="labelloc" val="east"/>
      <a name="type" val="output"/>
    </tool>
    <tool lib="2" name="NOT Gate"/>
    <tool lib="2" name="AND Gate"/>
    <tool lib="2" name="OR Gate"/>
    <tool lib="2" name="XOR Gate"/>
    <tool lib="2" name="NAND Gate"/>
    <tool lib="2" name="NOR Gate"/>
  </toolbar>
  <circuit name="main">
    <a name="appearance" val="classic"/>
    <comp lib="1" loc="(100,30)" name="Pin">
      <a name="facing" val="south"/>
      <a name="labelloc" val="east"/>
      <a name="type" val="output"/>
    </comp>
    <comp lib="1" loc="(120,100)" name="Probe">
      <a name="facing" val="north"/>
    </comp>
    <comp lib="1" loc="(230,50)" name="Pin">
      <a name="label" val="Load"/>
    </comp>
    <comp lib="1" loc="(240,300)" name="Pin">
      <a name="label" val="B"/>
    </comp>
    <comp lib="1" loc="(260,60)" name="Splitter">
      <a name="appear" val="right"/>
      <a name="facing" val="south"/>
      <a name="fanout" val="8"/>
      <a name="incoming" val="8"/>
    </comp>
    <comp lib="1" loc="(280,100)" name="Clock">
      <a name="facing" val="north"/>
    </comp>
    <comp lib="1" loc="(300,270)" name="Pin">
      <a name="facing" val="south"/>
      <a name="labelloc" val="east"/>
      <a name="type" val="output"/>
    </comp>
    <comp lib="1" loc="(350,130)" name="Splitter">
      <a name="appear" val="right"/>
      <a name="bit1" val="0"/>
      <a name="bit2" val="0"/>
      <a name="bit3" val="0"/>
      <a name="bit4" val="1"/>
      <a name="bit5" val="1"/>
      <a name="bit6" val="1"/>
      <a name="bit7" val="1"/>
      <a name="facing" val="north"/>
      <a name="incoming" val="8"/>
      <a name="spacing" val="5"/>
    </comp>
    <comp lib="1" loc="(40,60)" name="Pin"/>
    <comp lib="11" loc="(190,310)" name="Callout">
      <a name="background" val="#ace8b5b5"/>
      <a name="dx" val="15"/>
      <a name="dy" val="-10"/>
      <a name="halign" val="right"/>
      <a name="text">Type 'B' to toggle
this input pin.</a>
    </comp>
    <comp lib="11" loc="(200,250)" name="Callout">
      <a name="background" val="#ace8b5b5"/>
      <a name="dx" val="15"/>
      <a name="dy" val="10"/>
      <a name="halign" val="right"/>
      <a name="text">Type 'A' to poke
this button.</a>
    </comp>
    <comp lib="2" loc="(290,290)" name="AND Gate">
      <a name="size" val="30"/>
    </comp>
    <comp lib="2" loc="(90,50)" name="AND Gate">
      <a name="size" val="30"/>
    </comp>
    <comp lib="5" loc="(310,60)" name="Counter"/>
    <comp lib="6" loc="(140,80)" name="Meter">
      <a name="facing" val="north"/>
      <a name="shape" val="dial"/>
      <a name="width" val="4"/>
    </comp>
    <comp lib="6" loc="(170,80)" name="DipSwitch"/>
    <comp lib="6" loc="(240,270)" name="Button">
      <a name="color" val="#fbffa8"/>
      <a name="label" val="A"/>
    </comp>
    <comp lib="6" loc="(310,100)" name="Button">
      <a name="color" val="#ffa3ee"/>
      <a name="facing" val="north"/>
      <a name="label" val="R"/>
    </comp>
    <comp lib="6" loc="(320,30)" name="LED">
      <a name="facing" val="south"/>
      <a name="label" val="Overflow"/>
      <a name="labelloc" val="west"/>
    </comp>
    <comp lib="6" loc="(350,30)" name="7-Segment Display"/>
    <comp lib="6" loc="(40,30)" name="Button">
      <a name="color" val="#fbffa8"/>
      <a name="label" val="A"/>
    </comp>
    <comp lib="6" loc="(400,30)" name="7-Segment Display"/>
    <comp lib="6" loc="(80,90)" name="Slider">
      <a name="facing" val="west"/>
      <a name="width" val="4"/>
    </comp>
    <comp lib="9" loc="(350,30)" name="Hex_to_7_Segment_decoder"/>
    <comp lib="9" loc="(400,30)" name="Hex_to_7_Segment_decoder"/>
    <wire from="(100,30)" to="(100,50)"/>
    <wire from="(120,90)" to="(120,100)"/>
    <wire from="(120,90)" to="(140,90)"/>
    <wire from="(140,80)" to="(140,90)"/>
    <wire from="(230,50)" to="(280,50)"/>
    <wire from="(240,270)" to="(250,270)"/>
    <wire from="(240,300)" to="(260,300)"/>
