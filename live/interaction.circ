    <wire from="(260,60)" to="(280,60)"/>
    <wire from="(280,90)" to="(280,100)"/>
    <wire from="(280,90)" to="(290,90)"/>
    <wire from="(290,290)" to="(300,290)"/>
    <wire from="(290,80)" to="(290,90)"/>
    <wire from="(300,270)" to="(300,290)"/>
    <wire from="(300,80)" to="(300,90)"/>
    <wire from="(300,90)" to="(310,90)"/>
    <wire from="(310,60)" to="(330,60)"/>
    <wire from="(310,70)" to="(320,70)"/>
    <wire from="(310,90)" to="(310,100)"/>
    <wire from="(320,30)" to="(320,70)"/>
    <wire from="(330,130)" to="(350,130)"/>
    <wire from="(330,60)" to="(330,130)"/>
    <wire from="(40,30)" to="(50,30)"/>
    <wire from="(40,60)" to="(60,60)"/>
    <wire from="(50,30)" to="(50,40)"/>
    <wire from="(50,40)" to="(60,40)"/>
    <wire from="(80,90)" to="(120,90)"/>
    <wire from="(90,50)" to="(100,50)"/>
