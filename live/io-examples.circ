<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="5.2.0-HC" version="1.0" website="https://kevinawalsh.github.com/logisim-evolution">
  This file is intended to be loaded by Logisim-evolution (https://github.com/kevinawalsh/logisim-evolution).

  <lib desc="#Base" name="0"/>
  <lib desc="#Wiring" name="1"/>
  <lib desc="#Gates" name="2"/>
  <lib desc="#Plexers" name="3"/>
  <lib desc="#Arithmetic" name="4"/>
  <lib desc="#Memory" name="5"/>
  <lib desc="#I/O" name="6"/>
  <lib desc="#Analog" name="7"/>
  <lib desc="#Audio" name="8"/>
  <lib desc="#BFH-Praktika" name="9"/>
  <lib desc="#External I/O" name="10"/>
  <lib desc="#Decor" name="11"/>
  <main name="ledbar-example"/>
  <options/>
  <toolbar>
    <tool lib="0" name="Poke Tool"/>
    <tool lib="0" name="Edit Tool"/>
    <tool lib="0" name="Wiring Tool"/>
    <tool lib="0" name="Cutter Tool"/>
    <tool lib="0" name="Text Tool"/>
    <tool lib="11" name="Callout"/>
    <tool lib="11" name="Image"/>
    <sep/>
    <tool lib="1" name="Pin"/>
    <tool lib="1" name="Pin">
      <a name="facing" val="west"/>
      <a name="labelloc" val="east"/>
      <a name="type" val="output"/>
    </tool>
    <tool lib="2" name="NOT Gate"/>
    <tool lib="2" name="AND Gate"/>
    <tool lib="2" name="OR Gate"/>
    <tool lib="2" name="XOR Gate"/>
    <tool lib="2" name="NAND Gate"/>
    <tool lib="2" name="NOR Gate"/>
  </toolbar>
  <circuit name="ledbar-example">
    <comp lib="1" loc="(160,270)" name="Clock">
      <a name="facing" val="north"/>
    </comp>
    <comp lib="1" loc="(400,220)" name="Clock">
      <a name="facing" val="north"/>
    </comp>
    <comp lib="11" loc="(350,140)" name="Callout">
      <a name="background" val="#6938ff36"/>
      <a name="dx" val="26"/>
      <a name="dy" val="23"/>
      <a name="format" val="wrapped"/>
      <a name="text" val="1-bit random number generator, feeding into an 8-stage shift register"/>
      <a name="textwidth" val="230"/>
      <a name="valign" val="bottom-overall"/>
    </comp>
    <comp lib="11" loc="(40,140)" name="Callout">
      <a name="background" val="#83ff8536"/>
      <a name="dx" val="26"/>
      <a name="dy" val="23"/>
      <a name="format" val="wrapped"/>
      <a name="text" val="8-segment LED bar, with round LEDs, showing the contents of an 8-bit counter"/>
      <a name="textwidth" val="262"/>
      <a name="valign" val="bottom-overall"/>
    </comp>
    <comp lib="11" loc="(590,260)" name="Callout">
      <a name="background" val="#6938ff36"/>
      <a name="dx" val="-19"/>
      <a name="dy" val="-17"/>
      <a name="format" val="wrapped"/>
      <a name="halign" val="right"/>
      <a name="text" val="Contents of shift register are displayed with an 8-segment LED Bar"/>
      <a name="textwidth" val="231"/>
      <a name="valign" val="top"/>
    </comp>
    <comp lib="5" loc="(180,240)" name="Counter"/>
    <comp lib="5" loc="(390,160)" name="Random">
      <a name="width" val="1"/>
    </comp>
    <comp lib="5" loc="(460,180)" name="Shift Register"/>
    <comp lib="6" loc="(550,220)" name="LEDBar">
      <a name="color" val="#ff4947"/>
      <a name="facing" val="west"/>
      <a name="labelloc" val="north"/>
    </comp>
    <comp lib="6" loc="(90,170)" name="LEDBar">
      <a name="dotshape" val="circle"/>
      <a name="inputtype" val="bus"/>
    </comp>
    <wire from="(160,260)" to="(160,270)"/>
    <wire from="(180,240)" to="(200,240)"/>
    <wire from="(200,200)" to="(200,240)"/>
    <wire from="(400,200)" to="(400,210)"/>
    <wire from="(400,210)" to="(400,220)"/>
    <wire from="(400,210)" to="(440,210)"/>
    <wire from="(430,180)" to="(460,180)"/>
    <wire from="(440,190)" to="(440,210)"/>
    <wire from="(440,190)" to="(460,190)"/>
    <wire from="(480,200)" to="(480,220)"/>
    <wire from="(490,200)" to="(490,220)"/>
    <wire from="(500,200)" to="(500,220)"/>
    <wire from="(510,200)" to="(510,220)"/>
    <wire from="(520,200)" to="(520,220)"/>
    <wire from="(530,200)" to="(530,220)"/>
    <wire from="(540,200)" to="(540,220)"/>
    <wire from="(550,200)" to="(550,220)"/>
    <wire from="(70,170)" to="(70,200)"/>
    <wire from="(70,170)" to="(90,170)"/>
    <wire from="(70,200)" to="(200,200)"/>
  </circuit>
</project>
