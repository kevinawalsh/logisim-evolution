    <comp lib="11" loc="(14,273)" name="Text">
      <a name="halign" val="center"/>
      <a name="text">A multi-bit NOT gate performs the same transformation as a bitwise operation, with each output bit
determined by the corresponding input bit.</a>
      <a name="valign" val="base"/>
    </comp>
    <comp lib="11" loc="(17,50)" name="Text">
      <a name="halign" val="center"/>
      <a name="text">A NOT gate by default emits the complement of whatever input it receives. So it outputs a 1 when the input
is 0, and it outputs a 0 when the input is 1.</a>
      <a name="valign" val="base"/>
    </comp>
    <comp lib="11" loc="(18,242)" name="Text">
      <a name="font" val="SansSerif bold 14"/>
      <a name="halign" val="center"/>
      <a name="text" val="Multi-bit NOT Gate"/>
      <a name="valign" val="base"/>
    </comp>
    <comp lib="11" loc="(187,589)" name="Text">
      <a name="halign" val="center"/>
      <a name="text" val="output"/>
      <a name="valign" val="base"/>
    </comp>
    <comp lib="11" loc="(187,606)" name="Text">
      <a name="halign" val="center"/>
      <a name="text" val="floating"/>
      <a name="valign" val="base"/>
    </comp>
    <comp lib="11" loc="(188,628)" name="Text">
      <a name="halign" val="center"/>
      <a name="text" val="0"/>
      <a name="valign" val="base"/>
    </comp>
    <comp lib="11" loc="(191,648)" name="Text">
