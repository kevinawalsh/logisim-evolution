  <circuit name="inner">
    <comp lib="1" loc="(170,100)" name="Pin">
      <a name="label" val="A"/>
    </comp>
    <comp lib="1" loc="(170,150)" name="Pin">
      <a name="label" val="B"/>
    </comp>
    <comp lib="1" loc="(170,200)" name="Pin">
      <a name="label" val="C"/>
    </comp>
    <comp lib="1" loc="(380,120)" name="Pin">
      <a name="facing" val="west"/>
      <a name="label" val="P"/>
      <a name="labelloc" val="east"/>
      <a name="type" val="output"/>
    </comp>
    <comp lib="1" loc="(380,180)" name="Pin">
      <a name="facing" val="west"/>
      <a name="label" val="Q"/>
      <a name="labelloc" val="east"/>
      <a name="type" val="output"/>
    </comp>
    <comp lib="11" loc="(20,20)" name="Text">
      <a name="text">inner circuit: takes three 1-bit inputs, A, B, and C, and produces two 1-bit outputs, P and Q,
where P = A * B, and Q = B ^ C.</a>
