      <a name="facing" val="north"/>
    </comp>
    <comp lib="5" loc="(400,260)" name="ROM">
      <a name="contents">addr/data: 8 4
48*7 31*0 2 f 0 9 9 d
a 3 3 7 8 e 3 0
9 a a 5 d e 2 1
