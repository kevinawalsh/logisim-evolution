  </circuit>
  <circuit name="demo-arduino-trigger-boops">
    <a name="appearance" val="classic"/>
    <comp lib="0" loc="(168,223)" name="Text">
      <a name="text">These values control the "envelope" shape,
attack-sustain-delay style... each value
here is in range [0, 255], which we scale
up to [0, 32767] before multiplying.</a>
    </comp>
    <comp lib="0" loc="(32,385)" name="Callout">
      <a name="background" val="#feffa189"/>
      <a name="dx" val="57"/>
      <a name="dy" val="113"/>
      <a name="foreground" val="#cc45bf"/>
      <a name="text">Connect arduino
to usb, then poke
to connect.</a>
    </comp>
    <comp lib="0" loc="(42,77)" name="Callout">
      <a name="background" val="#feffa189"/>
      <a name="dx" val="35"/>
      <a name="dy" val="75"/>
      <a name="foreground" val="#cc45bf"/>
      <a name="text">Each click resets this counter.
It then goes from 0 to some
big number, taking a while,
and we scale that down to [0, 7]</a>
    </comp>
    <comp lib="0" loc="(451,363)" name="Callout">
      <a name="background" val="#feffa189"/>
      <a name="dx" val="-56"/>
      <a name="dy" val="45"/>
      <a name="foreground" val="#cc45bf"/>
      <a name="text">x-accel controls click tempo.
z-accel controls tone frequency.</a>
    </comp>
    <comp lib="1" loc="(200,440)" name="Bit Extender">
      <a name="out_width" val="12"/>
      <a name="type" val="zero"/>
    </comp>
    <comp lib="1" loc="(210,590)" name="Probe">
      <a name="facing" val="north"/>
      <a name="label" val="X"/>
      <a name="labelloc" val="south"/>
      <a name="radix" val="10unsigned"/>
    </comp>
    <comp lib="1" loc="(230,460)" name="Constant">
      <a name="radix" val="10unsigned"/>
      <a name="value" val="0x00a"/>
      <a name="width" val="12"/>
    </comp>
    <comp lib="1" loc="(260,590)" name="Probe">
      <a name="facing" val="north"/>
      <a name="label" val="Y"/>
      <a name="labelloc" val="south"/>
      <a name="radix" val="10unsigned"/>
    </comp>
    <comp lib="1" loc="(290,110)" name="Tunnel">
      <a name="facing" val="north"/>
      <a name="label" val="freqZ"/>
      <a name="width" val="12"/>
    </comp>
    <comp lib="1" loc="(310,390)" name="Constant">
      <a name="facing" val="north"/>
      <a name="radix" val="10unsigned"/>
      <a name="value" val="0x00"/>
      <a name="width" val="8"/>
    </comp>
    <comp lib="1" loc="(310,590)" name="Probe">
      <a name="facing" val="north"/>
      <a name="label" val="Z"/>
      <a name="labelloc" val="south"/>
      <a name="radix" val="10unsigned"/>
    </comp>
    <comp lib="1" loc="(360,360)" name="Tunnel">
      <a name="label" val="bang"/>
    </comp>
    <comp lib="1" loc="(360,590)" name="Probe">
      <a name="facing" val="north"/>
      <a name="label" val="x"/>
      <a name="labelloc" val="south"/>
      <a name="radix" val="10unsigned"/>
    </comp>
    <comp lib="1" loc="(370,440)" name="Bit Extender">
