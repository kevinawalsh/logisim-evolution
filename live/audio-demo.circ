  <circuit name="diy-delayline-reverb">
    <a name="appearance" val="classic"/>
    <comp lib="0" loc="(234,670)" name="Callout">
      <a name="background" val="#f5f50074"/>
      <a name="dx" val="22"/>
      <a name="dy" val="-37"/>
      <a name="foreground" val="#bd48d1"/>
      <a name="text" val="Feed audio data in here...."/>
    </comp>
    <comp lib="0" loc="(536,450)" name="Callout">
      <a name="background" val="#f5f50074"/>
      <a name="dx" val="-31"/>
      <a name="dy" val="89"/>
      <a name="foreground" val="#bd48d1"/>
      <a name="text">This RAM can hold about 1 second of audio data
(16000 samples x 16-bits each).
The total amount can be adjusted
if you change the address bit-width,
and the counter-bit width.</a>
    </comp>
    <comp lib="0" loc="(56,38)" name="Text">
      <a name="text">(1) Send something into the RAM. 
- Maybe just the original audio?
- Or, mix the original audio together with feedback from the RAM output!
(2) Send something to the speakers (PCM audio output).
- Maybe just the RAM output?
- Or mix that together with the original audio?
(3) Add volume/boost somewhere...
- Maybe boost the feedback loop?
- Or boost the output of the RAM?
- Or both?</a>
    </comp>
    <comp lib="0" loc="(683,656)" name="Callout">
      <a name="background" val="#f5f50074"/>
      <a name="dx" val="-44"/>
      <a name="dy" val="-33"/>
      <a name="foreground" val="#bd48d1"/>
      <a name="text">... and it will come out 
here 1 second later.</a>
    </comp>
    <comp lib="1" loc="(270,590)" name="Clock">
      <a name="facing" val="north"/>
    </comp>
    <comp lib="1" loc="(340,590)" name="Clock"/>
    <comp lib="1" loc="(360,580)" name="Constant">
      <a name="value" val="0x1"/>
    </comp>
    <comp lib="1" loc="(810,200)" name="Clock">
      <a name="facing" val="north"/>
    </comp>
    <comp lib="1" loc="(870,280)" name="Clock">
      <a name="facing" val="north"/>
    </comp>
    <comp lib="5" loc="(290,560)" name="Counter">
      <a name="max" val="0x3fff"/>
      <a name="width" val="14"/>
    </comp>
    <comp lib="5" loc="(360,550)" name="RAM">
      <a name="addrWidth" val="14"/>
      <a name="dataWidth" val="16"/>
    </comp>
    <comp lib="6" loc="(20,260)" name="Button">
      <a name="color" val="#ff00e7"/>
      <a name="facing" val="south"/>
