  <circuit name="finch-parse-number">
    <a name="appearance" val="custom"/>
    <appear>
      <rect fill="none" height="30" stroke="#000000" stroke-width="2" width="40" x="50" y="70"/>
      <text dominant-baseline="central" fill="#404040" font-family="SansSerif" font-size="10" text-anchor="start" x="55" y="80">frac</text>
      <text dominant-baseline="central" fill="#404040" font-family="SansSerif" font-size="10" text-anchor="start" x="55" y="90">int</text>
      <polyline fill="none" points="82,71 70,100" stroke="#000000"/>
      <circ-port height="8" pin="130,180" width="8" x="46" y="76"/>
      <circ-port height="8" pin="140,320" width="8" x="46" y="86"/>
      <circ-port height="10" pin="370,290" width="10" x="85" y="75"/>
      <circ-anchor facing="east" height="6" width="6" x="87" y="77"/>
    </appear>
    <comp lib="0" loc="(54,25)" name="Text">
      <a name="text">The "BlueBird Connector" program used to communicate with the Finch robots
has an unfortunate output format for the HTTP API. For accerlations, it
outputs a signed floating point number, with 1 or more decimal places.
For a number like "9.81", we take the "9" as an integer, and multiply by 10.
We take the "8" as an ascii character, and convert to an integer in range [0, 9],
then add that to the previous result. We ignore anything after that first decimal place.
We output the result as a signed 16 bit number, so 81 in this example.
Note: if the integer part is negative, we need to negate the decimal part too!</a>
    </comp>
    <comp lib="1" loc="(130,180)" name="Pin">
      <a name="label" val="FractionPart"/>
      <a name="radix" val="16"/>
      <a name="width" val="8"/>
    </comp>
    <comp lib="1" loc="(140,320)" name="Pin">
      <a name="label" val="IntegerPart"/>
      <a name="radix" val="10signed"/>
      <a name="width" val="8"/>
    </comp>
    <comp lib="1" loc="(200,320)" name="Bit Extender"/>
    <comp lib="1" loc="(210,250)" name="Constant">
      <a name="value" val="0x0000"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="1" loc="(230,340)" name="Constant">
      <a name="radix" val="10signed"/>
      <a name="value" val="0x000a"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="1" loc="(370,290)" name="Pin">
      <a name="facing" val="west"/>
      <a name="labelloc" val="east"/>
      <a name="radix" val="10signed"/>
      <a name="type" val="output"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="3" loc="(280,190)" name="Multiplexer">
      <a name="enable" val="false"/>
      <a name="size" val="20"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="4" loc="(260,260)" name="Comparator">
      <a name="width" val="16"/>
    </comp>
    <comp lib="8" loc="(190,180)" name="LinearMap">
      <a name="domain" val="[48, 57]"/>
      <a name="range" val="[0, 9]"/>
      <a name="widthOut" val="16"/>
    </comp>
    <comp lib="8" loc="(250,200)" name="SaturatingNegator">
      <a name="mode" val="twosComplement"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="8" loc="(270,330)" name="SaturatingMultiplier">
      <a name="mode" val="twosComplement"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="8" loc="(340,290)" name="SaturatingAdder">
      <a name="mode" val="twosComplement"/>
      <a name="width" val="16"/>
    </comp>
    <wire from="(130,180)" to="(160,180)"/>
    <wire from="(140,320)" to="(160,320)"/>
    <wire from="(190,180)" to="(210,180)"/>
    <wire from="(200,320)" to="(210,320)"/>
    <wire from="(210,180)" to="(210,200)"/>
    <wire from="(210,180)" to="(260,180)"/>
    <wire from="(210,200)" to="(220,200)"/>
    <wire from="(210,250)" to="(220,250)"/>
    <wire from="(210,270)" to="(210,320)"/>
    <wire from="(210,270)" to="(220,270)"/>
    <wire from="(210,320)" to="(240,320)"/>
    <wire from="(230,340)" to="(240,340)"/>
    <wire from="(250,200)" to="(260,200)"/>
    <wire from="(260,250)" to="(270,250)"/>
    <wire from="(270,210)" to="(270,250)"/>
    <wire from="(270,330)" to="(290,330)"/>
    <wire from="(280,190)" to="(290,190)"/>
    <wire from="(290,190)" to="(290,280)"/>
    <wire from="(290,280)" to="(310,280)"/>
    <wire from="(290,300)" to="(290,330)"/>
    <wire from="(290,300)" to="(310,300)"/>
    <wire from="(340,290)" to="(370,290)"/>
  </circuit>
  <circuit name="finch-parse-boolean">
    <a name="appearance" val="custom"/>
    <appear>
      <rect fill="none" height="30" stroke="#000000" stroke-width="2" width="40" x="50" y="70"/>
      <text dominant-baseline="central" fill="#404040" font-family="SansSerif" font-size="10" text-anchor="start" x="55" y="90">t/f</text>
      <polyline fill="none" points="82,71 70,100" stroke="#000000"/>
      <circ-port height="8" pin="150,180" width="8" x="46" y="86"/>
      <circ-port height="10" pin="310,170" width="10" x="85" y="75"/>
      <circ-anchor facing="east" height="6" width="6" x="87" y="77"/>
    </appear>
    <comp lib="0" loc="(54,41)" name="Text">
      <a name="text">The "BlueBird Connector" program used to communicate with the Finch robots
has an unfortunate output format for the HTTP API. For booleans, it
outputs "true" or "false". We just check for the presence of "t" as the
first ascii byte.</a>
    </comp>
    <comp lib="1" loc="(150,180)" name="Pin">
      <a name="label" val="Ascii"/>
      <a name="radix" val="16"/>
      <a name="width" val="8"/>
    </comp>
    <comp lib="1" loc="(200,160)" name="Constant">
      <a name="value" val="0x74"/>
      <a name="width" val="8"/>
    </comp>
    <comp lib="1" loc="(310,170)" name="Pin">
      <a name="facing" val="west"/>
      <a name="labelloc" val="east"/>
      <a name="type" val="output"/>
    </comp>
    <comp lib="4" loc="(250,170)" name="Comparator"/>
    <wire from="(150,180)" to="(210,180)"/>
    <wire from="(200,160)" to="(210,160)"/>
    <wire from="(250,170)" to="(310,170)"/>
  </circuit>
  <circuit name="volume-limiter">
    <a name="appearance" val="custom"/>
    <appear>
      <rect fill="none" height="25" stroke="#000000" stroke-width="2" width="50" x="40" y="65"/>
      <text dominant-baseline="top" font-family="SansSerif" font-size="12" text-anchor="middle" x="65" y="63">volume</text>
      <circ-port height="8" pin="170,150" width="8" x="36" y="76"/>
      <circ-port height="8" pin="210,260" width="8" x="56" y="86"/>
      <circ-port height="10" pin="490,170" width="10" x="85" y="75"/>
      <circ-anchor facing="east" height="6" width="6" x="87" y="77"/>
    </appear>
    <comp lib="0" loc="(440,307)" name="Callout">
      <a name="dx" val="-63"/>
      <a name="dy" val="-55"/>
      <a name="foreground" val="#ed2d23"/>
      <a name="text">All of the constants here
were chosen by trial-and-error
to get a good range of boosting and damping.</a>
    </comp>
    <comp lib="0" loc="(46,31)" name="Text">
      <a name="text">This circuit takes a 16-bit signed audio signal, and either 
boosts the volume (up to about 5x louder) or limits the volume (up to 30x quieter).
The amount is controlled by a signed 8-bit input in the range [-128, 127].</a>
    </comp>
    <comp lib="1" loc="(170,150)" name="Pin">
      <a name="label" val="AudioSample"/>
      <a name="radix" val="10signed"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="1" loc="(210,260)" name="Pin">
      <a name="facing" val="north"/>
      <a name="label" val="Volume"/>
      <a name="radix" val="10signed"/>
      <a name="width" val="8"/>
    </comp>
    <comp lib="1" loc="(290,170)" name="Constant">
      <a name="radix" val="10signed"/>
      <a name="value" val="0x00000005"/>
      <a name="width" val="32"/>
    </comp>
    <comp lib="1" loc="(490,170)" name="Pin">
      <a name="facing" val="west"/>
      <a name="label" val="AdjustedSample"/>
      <a name="labelloc" val="east"/>
      <a name="radix" val="10signed"/>
      <a name="type" val="output"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="8" loc="(260,150)" name="FitRange">
      <a name="normalization" val="cap"/>
      <a name="typeIn" val="twosComplement"/>
      <a name="widthIn" val="16"/>
      <a name="widthOut" val="32"/>
    </comp>
    <comp lib="8" loc="(260,210)" name="LinearMap">
      <a name="domain" val="[-128, 127]"/>
      <a name="range" val="[95599345, 2147483647]"/>
      <a name="widthOut" val="31"/>
    </comp>
    <comp lib="8" loc="(310,210)" name="ScaledMath">
      <a name="function" val="exp"/>
      <a name="width" val="31"/>
    </comp>
    <comp lib="8" loc="(340,160)" name="SaturatingMultiplier">
      <a name="mode" val="twosComplement"/>
      <a name="width" val="32"/>
    </comp>
    <comp lib="8" loc="(350,210)" name="FitRange">
      <a name="normalization" val="cap"/>
      <a name="widthIn" val="31"/>
      <a name="widthOut" val="32"/>
    </comp>
    <comp lib="8" loc="(410,170)" name="SaturatingMultiplier">
      <a name="mode" val="twosComplement"/>
      <a name="normalization" val="fit"/>
      <a name="width" val="32"/>
    </comp>
    <comp lib="8" loc="(470,170)" name="FitRange">
      <a name="normalization" val="cap"/>
      <a name="typeIn" val="twosComplement"/>
      <a name="widthIn" val="32"/>
      <a name="widthOut" val="16"/>
    </comp>
    <wire from="(170,150)" to="(230,150)"/>
    <wire from="(210,210)" to="(210,260)"/>
    <wire from="(210,210)" to="(230,210)"/>
    <wire from="(260,150)" to="(310,150)"/>
    <wire from="(260,210)" to="(280,210)"/>
    <wire from="(290,170)" to="(310,170)"/>
    <wire from="(310,210)" to="(320,210)"/>
    <wire from="(340,160)" to="(380,160)"/>
    <wire from="(350,210)" to="(360,210)"/>
    <wire from="(360,180)" to="(360,210)"/>
    <wire from="(360,180)" to="(380,180)"/>
    <wire from="(410,170)" to="(440,170)"/>
    <wire from="(470,170)" to="(490,170)"/>
  </circuit>
  <circuit name="balancing-fader">
    <a name="appearance" val="custom"/>
    <appear>
      <rect fill="none" height="35" stroke="#000000" stroke-width="2" width="39" x="40" y="65"/>
      <text dominant-baseline="top" font-family="SansSerif" font-size="12" text-anchor="middle" x="65" y="63">mix</text>
      <polyline fill="none" points="48,75 56,81" stroke="#000000"/>
      <polyline fill="none" points="49,87 55,81" stroke="#000000"/>
      <polyline fill="none" points="55,81 66,81" stroke="#000000"/>
      <circ-port height="8" pin="200,200" width="8" x="36" y="66"/>
      <circ-port height="8" pin="160,440" width="8" x="56" y="96"/>
      <circ-port height="10" pin="470,250" width="10" x="75" y="75"/>
      <circ-port height="8" pin="200,270" width="8" x="36" y="86"/>
      <circ-anchor facing="east" height="6" width="6" x="77" y="77"/>
    </appear>
    <comp lib="0" loc="(23,36)" name="Text">
      <a name="text">This circuit takes two 16-bit signed audio signals, and mixes them into one
by taking some of one, and some of the other. The "balance" is controlled
by a user input, a signed 8-bit input in the range [-128, 127]. 
-128 means "use only the left sample, ignore the right"
0 means "use half of each sample"
+127 means "use only the right sample, ignore the left"</a>
    </comp>
    <comp lib="1" loc="(160,440)" name="Pin">
      <a name="facing" val="north"/>
      <a name="label" val="Balance"/>
      <a name="radix" val="10signed"/>
      <a name="width" val="8"/>
    </comp>
    <comp lib="1" loc="(200,200)" name="Pin">
      <a name="label" val="AudioSampleLeft"/>
      <a name="radix" val="10signed"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="1" loc="(200,270)" name="Pin">
      <a name="label" val="AudioSampleRight"/>
      <a name="radix" val="10signed"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="1" loc="(250,220)" name="Constant">
      <a name="radix" val="10signed"/>
      <a name="value" val="0x7fff"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="1" loc="(470,250)" name="Pin">
      <a name="facing" val="west"/>
      <a name="label" val="CombinedSample"/>
      <a name="labelloc" val="east"/>
      <a name="radix" val="10signed"/>
      <a name="type" val="output"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="8" loc="(210,400)" name="LinearMap">
      <a name="domain" val="[-128, 127]"/>
      <a name="range" val="[0, 32767]"/>
      <a name="widthOut" val="16"/>
    </comp>
    <comp lib="8" loc="(290,230)" name="SaturatingSubtractor">
      <a name="mode" val="twosComplement"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="8" loc="(320,280)" name="SaturatingMultiplier">
      <a name="mode" val="twosComplement"/>
      <a name="normalization" val="fit"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="8" loc="(340,210)" name="SaturatingMultiplier">
      <a name="mode" val="twosComplement"/>
      <a name="normalization" val="fit"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="8" loc="(430,250)" name="SaturatingAdder">
      <a name="mode" val="twosComplement"/>
      <a name="width" val="16"/>
    </comp>
    <wire from="(160,400)" to="(160,440)"/>
    <wire from="(160,400)" to="(180,400)"/>
    <wire from="(200,200)" to="(310,200)"/>
    <wire from="(200,270)" to="(290,270)"/>
    <wire from="(210,400)" to="(240,400)"/>
    <wire from="(240,240)" to="(240,290)"/>
    <wire from="(240,240)" to="(260,240)"/>
    <wire from="(240,290)" to="(240,400)"/>
    <wire from="(240,290)" to="(290,290)"/>
    <wire from="(250,220)" to="(260,220)"/>
    <wire from="(290,230)" to="(300,230)"/>
    <wire from="(300,220)" to="(300,230)"/>
    <wire from="(300,220)" to="(310,220)"/>
    <wire from="(320,280)" to="(350,280)"/>
    <wire from="(340,210)" to="(350,210)"/>
    <wire from="(350,210)" to="(350,240)"/>
    <wire from="(350,240)" to="(400,240)"/>
    <wire from="(350,260)" to="(350,280)"/>
    <wire from="(350,260)" to="(400,260)"/>
    <wire from="(430,250)" to="(470,250)"/>
  </circuit>
  <circuit name="filter-buildingblock">
    <a name="appearance" val="custom"/>
    <appear>
      <rect fill="none" height="47" stroke="#000000" stroke-width="2" width="90" x="60" y="53"/>
      <text dominant-baseline="central" fill="#404040" font-family="SansSerif" font-size="10" text-anchor="start" x="65" y="60">X</text>
      <text dominant-baseline="central" fill="#404040" font-family="SansSerif" font-size="10" text-anchor="start" x="63" y="93">coef</text>
      <text dominant-baseline="central" fill="#404040" font-family="SansSerif" font-size="10" text-anchor="end" x="145" y="61">Z-1</text>
      <text dominant-baseline="central" fill="#404040" font-family="SansSerif" font-size="10" text-anchor="end" x="145" y="90">Y</text>
      <text dominant-baseline="top" font-family="SansSerif" font-size="12" text-anchor="middle" x="99" y="54">filter</text>
      <text dominant-baseline="central" font-family="SansSerif" font-size="12" text-anchor="middle" x="105" y="76">building-</text>
      <text dominant-baseline="central" font-family="SansSerif" font-size="12" text-anchor="middle" x="110" y="89">block</text>
      <circ-port height="8" pin="160,200" width="8" x="56" y="56"/>
      <circ-port height="8" pin="160,310" width="8" x="66" y="96"/>
      <circ-port height="10" pin="370,200" width="10" x="145" y="55"/>
      <circ-port height="10" pin="370,300" width="10" x="145" y="85"/>
      <circ-anchor facing="east" height="6" width="6" x="147" y="57"/>
    </appear>
    <comp lib="0" loc="(27,40)" name="Text">
      <a name="text">This circuit is useful for creating a variety of filters.
It takes as inputs:
 * X, an audio sample, a signed 16-bit value typically in the range [-10000, +10000] or so.
 * β, a coefficient, a signed 16-bit value, within [-32768, 32767], but treated as a percentage [-100%, +100%]
It outputs:
 * Z-1, which is the same as the audio sample X but delayed by one clock tick,
 * Y, computed from β times the delayed audio sample X.</a>
    </comp>
    <comp lib="1" loc="(160,200)" name="Pin">
      <a name="label" val="X"/>
      <a name="radix" val="10signed"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="1" loc="(160,310)" name="Pin">
      <a name="label" val="β"/>
      <a name="radix" val="10signed"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="1" loc="(220,230)" name="Clock">
      <a name="facing" val="north"/>
    </comp>
    <comp lib="1" loc="(370,200)" name="Pin">
      <a name="facing" val="west"/>
      <a name="label" val="Z-1"/>
      <a name="labelloc" val="east"/>
      <a name="radix" val="10signed"/>
      <a name="type" val="output"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="1" loc="(370,300)" name="Pin">
      <a name="facing" val="west"/>
      <a name="label" val="Y"/>
      <a name="labelloc" val="east"/>
      <a name="radix" val="10signed"/>
      <a name="type" val="output"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="5" loc="(240,200)" name="Register">
      <a name="width" val="16"/>
    </comp>
    <comp lib="8" loc="(320,300)" name="SaturatingMultiplier">
      <a name="mode" val="twosComplement"/>
      <a name="normalization" val="fit"/>
      <a name="width" val="16"/>
    </comp>
    <wire from="(160,200)" to="(210,200)"/>
    <wire from="(160,310)" to="(290,310)"/>
    <wire from="(220,220)" to="(220,230)"/>
    <wire from="(240,200)" to="(270,200)"/>
    <wire from="(270,200)" to="(270,290)"/>
    <wire from="(270,200)" to="(370,200)"/>
    <wire from="(270,290)" to="(290,290)"/>
    <wire from="(320,300)" to="(370,300)"/>
  </circuit>
  <circuit name="recording-thank-you">
    <a name="appearance" val="custom"/>
    <appear>
      <rect fill="none" height="41" stroke="#000000" stroke-width="2" width="49" x="100" y="54"/>
      <text dominant-baseline="top" font-family="SansSerif" font-size="12" text-anchor="middle" x="125" y="78">thanks?!</text>
      <rect fill="#ffffff" height="17" stroke="#000000" width="13" x="119" y="60"/>
      <polyline fill="none" points="127,60 132,65" stroke="#000000"/>
      <visible-rgbled height="10" path="/RGBLED(150,200)" stroke-width="0" width="10" x="101" y="56"/>
      <circ-port height="8" pin="140,270" width="8" x="96" y="66"/>
      <circ-port height="10" pin="530,210" width="10" x="145" y="65"/>
      <circ-port height="8" pin="140,170" width="8" x="96" y="56"/>
      <circ-anchor facing="east" height="6" width="6" x="147" y="67"/>
    </appear>
    <comp lib="0" loc="(37,33)" name="Text">
      <a name="text">A pre-recorded message, stored in a ROM (read-only-memory).
The counter starts at 0, counting upwards, reading out 
the values from the rom one byte at a time. Each byte
is converted from 8-bit unsigned PCM (what the recording was)
to 16-bit signed PCM (which we will use in our circuits).</a>
    </comp>
    <comp lib="0" loc="(527,401)" name="Callout">
      <a name="dx" val="-153"/>
      <a name="dy" val="-30"/>
      <a name="foreground" val="#bd48d1"/>
      <a name="text">The recording is 107844 bytes long,
so we reset the counter whenever it
goes above that (OR, when the
user chooses Reset=1)</a>
    </comp>
    <comp lib="1" loc="(140,170)" name="Pin">
      <a name="behavior" val="pullup"/>
      <a name="label" val="Enable"/>
    </comp>
    <comp lib="1" loc="(140,270)" name="Pin">
      <a name="behavior" val="pulldown"/>
      <a name="label" val="Reset"/>
    </comp>
    <comp lib="1" loc="(200,200)" name="Clock">
      <a name="facing" val="north"/>
    </comp>
    <comp lib="1" loc="(300,380)" name="Constant">
      <a name="radix" val="10unsigned"/>
      <a name="value" val="0x1a544"/>
      <a name="width" val="18"/>
    </comp>
    <comp lib="1" loc="(530,210)" name="Pin">
      <a name="facing" val="west"/>
      <a name="label" val="AudioSignal"/>
      <a name="labelloc" val="east"/>
      <a name="radix" val="10signed"/>
      <a name="type" val="output"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="2" loc="(230,220)" name="OR Gate">
      <a name="facing" val="north"/>
      <a name="size" val="30"/>
    </comp>
    <comp lib="4" loc="(350,370)" name="Comparator">
      <a name="mode" val="unsigned"/>
      <a name="width" val="18"/>
    </comp>
    <comp lib="5" loc="(240,160)" name="Counter">
      <a name="max" val="0x3ffff"/>
      <a name="width" val="18"/>
    </comp>
    <comp lib="5" loc="(320,150)" name="ROM">
      <a name="addrWidth" val="18"/>
