      <a name="ongoal" val="load"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="6" loc="(170,310)" name="RGBLED"/>
    <comp lib="8" loc="(350,250)" name="LinearMap">
      <a name="domain" val="[0, 200]"/>
      <a name="range" val="[-10000, 10000]"/>
      <a name="widthIn" val="16"/>
      <a name="widthOut" val="16"/>
    </comp>
