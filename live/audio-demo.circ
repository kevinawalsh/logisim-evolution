  <circuit name="highpass-filter-onepole">
    <a name="appearance" val="custom"/>
    <appear>
      <rect fill="none" height="60" stroke="#000000" stroke-width="2" width="70" x="50" y="50"/>
      <text dominant-baseline="central" fill="#404040" font-family="SansSerif" font-size="10" text-anchor="start" x="66" y="100">alpha</text>
      <text dominant-baseline="top" font-family="SansSerif" font-size="12" text-anchor="middle" x="86" y="54">highpass</text>
      <text dominant-baseline="central" font-family="SansSerif" font-size="12" text-anchor="middle" x="84" y="77">filter</text>
      <circ-port height="8" pin="140,500" width="8" x="76" y="106"/>
      <circ-port height="8" pin="170,210" width="8" x="46" y="76"/>
      <circ-port height="10" pin="670,310" width="10" x="115" y="75"/>
      <circ-anchor facing="east" height="6" width="6" x="117" y="77"/>
    </appear>
    <comp lib="0" loc="(22,25)" name="Text">
      <a name="text">This is a high-pass filter, with a parameter beta to control where the dropoff is.
The parameter beta is a 16-bit unsigned number, from 0 to 65535, but we
treat it mathematically as if it were a percentage from 0% (0) to 100% (65535). 
The filter equation looks similar to the low-pass one, but rearranged...
To compute the output y[n] for the current step:
       y[n] = ( alpha * (y[n-1]) + alpha * (x[n] - x[n-1]) ) * lambda
where lambda = (1+a)/(2a). To simplify the circuit, we rearrange this to:
       y[n] = (  y[n-1] + x[n] - x[n-1] ) * ( (1 + alpha) / 2 )</a>
    </comp>
    <comp lib="0" loc="(251,195)" name="Text">
      <a name="text" val="x[n]"/>
    </comp>
    <comp lib="0" loc="(397,580)" name="Callout">
      <a name="dx" val="-38"/>
      <a name="dy" val="-23"/>
      <a name="foreground" val="#cc45bf"/>
      <a name="text">This part is calculating (100%+alpha)/2
where 100% is represented as 2billion.</a>
    </comp>
    <comp lib="0" loc="(573,299)" name="Text">
      <a name="text" val="y[n]"/>
    </comp>
    <comp lib="1" loc="(140,500)" name="Pin">
      <a name="label" val="alpha"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="1" loc="(170,210)" name="Pin">
      <a name="label" val="x"/>
      <a name="radix" val="10signed"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="1" loc="(290,520)" name="Constant">
      <a name="radix" val="10unsigned"/>
      <a name="value" val="0x7fffffff"/>
      <a name="width" val="32"/>
    </comp>
    <comp lib="1" loc="(300,280)" name="Clock">
      <a name="facing" val="north"/>
    </comp>
    <comp lib="1" loc="(300,400)" name="Clock">
      <a name="facing" val="north"/>
    </comp>
    <comp lib="1" loc="(340,540)" name="Constant">
      <a name="radix" val="10unsigned"/>
      <a name="value" val="0x00000002"/>
      <a name="width" val="32"/>
    </comp>
    <comp lib="1" loc="(670,310)" name="Pin">
      <a name="facing" val="west"/>
      <a name="label" val="y"/>
      <a name="labelloc" val="east"/>
      <a name="radix" val="10signed"/>
      <a name="type" val="output"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="5" loc="(320,250)" name="Register">
      <a name="label" val="x[n-1]"/>
      <a name="width" val="32"/>
    </comp>
    <comp lib="5" loc="(320,370)" name="Register">
      <a name="label" val="y[n-1]"/>
      <a name="width" val="32"/>
    </comp>
    <comp lib="8" loc="(190,500)" name="LinearMap">
      <a name="domain" val="[0, 65535]"/>
      <a name="range" val="[0, 2147483647]"/>
      <a name="widthIn" val="16"/>
      <a name="widthOut" val="32"/>
    </comp>
    <comp lib="8" loc="(220,210)" name="FitRange">
      <a name="normalization" val="center"/>
      <a name="typeIn" val="twosComplement"/>
      <a name="widthIn" val="16"/>
      <a name="widthOut" val="32"/>
    </comp>
    <comp lib="8" loc="(330,510)" name="SaturatingAdder">
      <a name="width" val="32"/>
    </comp>
    <comp lib="8" loc="(390,220)" name="SaturatingSubtractor">
      <a name="mode" val="twosComplement"/>
      <a name="width" val="32"/>
    </comp>
    <comp lib="8" loc="(390,520)" name="SaturatingDivider">
      <a name="width" val="32"/>
    </comp>
    <comp lib="8" loc="(480,300)" name="SaturatingAdder">
      <a name="mode" val="twosComplement"/>
      <a name="width" val="32"/>
    </comp>
    <comp lib="8" loc="(540,310)" name="SaturatingMultiplier">
      <a name="mode" val="twosComplement"/>
      <a name="normalization" val="fit"/>
      <a name="width" val="32"/>
    </comp>
    <comp lib="8" loc="(640,310)" name="FitRange">
      <a name="normalization" val="cap"/>
      <a name="typeIn" val="twosComplement"/>
      <a name="widthIn" val="32"/>
      <a name="widthOut" val="16"/>
    </comp>
    <wire from="(140,500)" to="(160,500)"/>
    <wire from="(170,210)" to="(190,210)"/>
