  <circuit name="recording-canning-ramps">
    <a name="appearance" val="custom"/>
    <appear>
      <rect fill="none" height="41" stroke="#000000" stroke-width="2" width="49" x="100" y="54"/>
      <text dominant-baseline="top" font-family="SansSerif" font-size="12" text-anchor="middle" x="125" y="78">canning</text>
      <rect fill="#ffffff" height="17" stroke="#000000" width="13" x="119" y="60"/>
      <polyline fill="none" points="127,60 132,65" stroke="#000000"/>
      <visible-rgbled height="10" path="/RGBLED(150,200)" stroke-width="0" width="10" x="101" y="56"/>
      <circ-port height="8" pin="140,270" width="8" x="96" y="66"/>
      <circ-port height="10" pin="530,210" width="10" x="145" y="65"/>
      <circ-port height="8" pin="140,170" width="8" x="96" y="56"/>
      <circ-anchor facing="east" height="6" width="6" x="147" y="67"/>
    </appear>
    <comp lib="0" loc="(37,33)" name="Text">
      <a name="text">A pre-recorded message, stored in a ROM (read-only-memory).
The counter starts at 0, counting upwards, reading out 
the values from the rom 16-bits at a time. The recording
is already in 16-bit signed PCM format at 16kHz audio rate.</a>
    </comp>
    <comp lib="0" loc="(527,401)" name="Callout">
      <a name="dx" val="-153"/>
      <a name="dy" val="-30"/>
      <a name="foreground" val="#bd48d1"/>
      <a name="text">The recording is 563245 samples long,
so we reset the counter whenever it
goes above that (OR, when the
user chooses Reset=1)</a>
    </comp>
    <comp lib="1" loc="(140,170)" name="Pin">
      <a name="behavior" val="pullup"/>
      <a name="label" val="Enable"/>
    </comp>
    <comp lib="1" loc="(140,270)" name="Pin">
      <a name="behavior" val="pulldown"/>
      <a name="label" val="Reset"/>
    </comp>
