      <a name="facing" val="north"/>
    </comp>
    <comp lib="1" loc="(300,380)" name="Constant">
      <a name="radix" val="10unsigned"/>
      <a name="value" val="0x8982d"/>
      <a name="width" val="20"/>
    </comp>
