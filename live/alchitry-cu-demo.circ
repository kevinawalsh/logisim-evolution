  <circuit name="debounce">
    <a name="appearance" val="custom"/>
    <appear>
      <rect fill="none" height="40" stroke="#000000" stroke-width="2" width="60" x="50" y="60"/>
      <text dominant-baseline="central" fill="#404040" font-family="SansSerif" font-size="10" text-anchor="start" x="55" y="80">Btn</text>
      <text dominant-baseline="central" fill="#404040" font-family="SansSerif" font-size="10" text-anchor="end" x="105" y="80">Value</text>
      <text dominant-baseline="central" fill="#404040" font-family="SansSerif" font-size="10" text-anchor="end" x="105" y="90">Edge</text>
      <text dominant-baseline="top" font-family="SansSerif" font-size="12" text-anchor="middle" x="80" y="59">debounce</text>
      <text dominant-baseline="central" fill="#404040" font-family="SansSerif" font-size="10" text-anchor="start" x="55" y="90">1ms</text>
      <circ-port height="8" pin="70,240" width="8" x="46" y="76"/>
      <circ-port height="10" pin="700,360" width="10" x="105" y="75"/>
      <circ-port height="10" pin="770,440" width="10" x="105" y="85"/>
      <circ-port height="8" pin="220,380" width="8" x="46" y="86"/>
      <circ-anchor facing="east" height="6" width="6" x="107" y="77"/>
    </appear>
    <comp lib="1" loc="(100,280)" name="Clock">
      <a name="facing" val="north"/>
    </comp>
    <comp lib="1" loc="(220,280)" name="Tunnel">
      <a name="facing" val="north"/>
      <a name="label" val="1ms"/>
      <a name="labelfont" val="SansSerif plain 9"/>
    </comp>
    <comp lib="1" loc="(220,370)" name="Tunnel">
      <a name="facing" val="south"/>
      <a name="label" val="1ms"/>
      <a name="labelfont" val="SansSerif plain 9"/>
    </comp>
    <comp lib="1" loc="(220,380)" name="Pin">
      <a name="facing" val="north"/>
      <a name="label" val="enable_1ms"/>
      <a name="labelloc" val="south"/>
    </comp>
    <comp lib="1" loc="(290,280)" name="Tunnel">
      <a name="facing" val="north"/>
      <a name="label" val="1ms"/>
      <a name="labelfont" val="SansSerif plain 9"/>
    </comp>
    <comp lib="1" loc="(470,240)" name="Constant">
      <a name="value" val="0x00"/>
      <a name="width" val="5"/>
    </comp>
    <comp lib="1" loc="(480,280)" name="Tunnel">
      <a name="facing" val="north"/>
      <a name="label" val="1ms"/>
      <a name="labelfont" val="SansSerif plain 9"/>
    </comp>
    <comp lib="1" loc="(510,390)" name="Tunnel">
      <a name="facing" val="east"/>
      <a name="label" val="1ms"/>
      <a name="labelfont" val="SansSerif plain 9"/>
    </comp>
    <comp lib="1" loc="(580,390)" name="Clock">
      <a name="facing" val="north"/>
    </comp>
    <comp lib="1" loc="(630,470)" name="Tunnel">
      <a name="facing" val="north"/>
      <a name="label" val="1ms"/>
      <a name="labelfont" val="SansSerif plain 9"/>
    </comp>
    <comp lib="1" loc="(680,470)" name="Clock">
      <a name="facing" val="north"/>
    </comp>
    <comp lib="1" loc="(70,240)" name="Pin">
      <a name="label" val="Button"/>
    </comp>
    <comp lib="1" loc="(700,360)" name="Pin">
      <a name="facing" val="west"/>
      <a name="label" val="Current"/>
      <a name="labelloc" val="east"/>
      <a name="type" val="output"/>
    </comp>
    <comp lib="1" loc="(720,460)" name="Tunnel">
      <a name="facing" val="north"/>
      <a name="label" val="1ms"/>
      <a name="labelfont" val="SansSerif plain 9"/>
    </comp>
    <comp lib="1" loc="(770,440)" name="Pin">
      <a name="facing" val="west"/>
      <a name="label" val="RisingEdge"/>
      <a name="labelloc" val="east"/>
      <a name="type" val="output"/>
    </comp>
    <comp lib="10" loc="(10,10)" name="Text">
      <a name="background" val="#f3ff214e"/>
      <a name="format" val="markdownish"/>
      <a name="text">A button-debouncing circuit, using four registers:
* sync0,1: input chain to resolve meta-stability issues.
* sample0,1: the button input value sampled once per ms, higher 
  resolution isn't needed for user input.  
* counter: resets to 0 when button input changes, counts upwards (once per 
  ms), while the input is stable (6 bit counter, so max is 31).
* state: captures the button state when the counter overflows, i.e.
  when the the last 31ms of samples have been constant.
* edge: the captured state from one clock tick ago, used to generate
  a short 1-cycle pulse whenever the captured state rises from 0 to 1,
  i.e. detecting the moment the button was pressed.</a>
      <a name="textwidth" val="550"/>
    </comp>
    <comp lib="10" loc="(437,223)" name="Text">
      <a name="halign" val="center"/>
      <a name="text" val="changed"/>
      <a name="valign" val="base"/>
    </comp>
    <comp lib="10" loc="(584,281)" name="Text">
      <a name="halign" val="center"/>
      <a name="text" val="stable for a while"/>
      <a name="valign" val="base"/>
    </comp>
    <comp lib="10" loc="(630,326)" name="Text">
      <a name="text">Current only changes at the end of
clock cycles where enable_1ms was high.</a>
      <a name="valign" val="base"/>
    </comp>
    <comp lib="10" loc="(676,520)" name="Callout">
      <a name="dx" val="38"/>
      <a name="dy" val="-17"/>
      <a name="format" val="wrapped"/>
      <a name="halign" val="right"/>
      <a name="style" val="margin: 4px;"/>
      <a name="text" val="Note: including the 1ms pulse in the AND ensures that RisingEdge is high for only one clock cycle, coinciding with the 1ms pulse (in case other downstream components sample this signal on the same 1ms pulse)."/>
      <a name="textwidth" val="357"/>
      <a name="valign" val="base"/>
    </comp>
    <comp lib="10" loc="(782,392)" name="Text">
      <a name="text">RisingEdge is high after
Current goes high, during
the next enable_1ms pulse.</a>
      <a name="valign" val="base"/>
    </comp>
    <comp lib="10" loc="(88,345)" name="Callout">
      <a name="dx" val="29"/>
      <a name="dy" val="-39"/>
      <a name="format" val="wrapped"/>
      <a name="halign" val="center"/>
      <a name="style" val="margin: 4px;"/>
      <a name="text" val="2-stage input chain to avoid meta-stability (sampling every clock cycle)"/>
      <a name="textwidth" val="118"/>
      <a name="valign" val="top"/>
    </comp>
    <comp lib="2" loc="(410,230)" name="XOR Gate">
      <a name="size" val="30"/>
    </comp>
    <comp lib="2" loc="(550,380)" name="AND Gate">
      <a name="size" val="30"/>
    </comp>
    <comp lib="2" loc="(760,440)" name="AND Gate">
      <a name="inputs" val="3"/>
      <a name="negate1" val="true"/>
      <a name="size" val="30"/>
    </comp>
    <comp lib="5" loc="(120,240)" name="Register">
      <a name="label" val="sync0"/>
      <a name="width" val="1"/>
    </comp>
    <comp lib="5" loc="(170,240)" name="Register">
      <a name="label" val="sync1"/>
      <a name="width" val="1"/>
    </comp>
    <comp lib="5" loc="(260,240)" name="Register">
      <a name="label" val="sample0"/>
      <a name="width" val="1"/>
    </comp>
    <comp lib="5" loc="(330,240)" name="Register">
      <a name="label" val="sample1"/>
      <a name="width" val="1"/>
    </comp>
    <comp lib="5" loc="(520,240)" name="Counter">
      <a name="label" val="counter"/>
      <a name="max" val="0x1f"/>
      <a name="width" val="5"/>
    </comp>
    <comp lib="5" loc="(600,360)" name="Register">
      <a name="label" val="state"/>
      <a name="width" val="1"/>
    </comp>
    <comp lib="5" loc="(700,440)" name="Register">
      <a name="label" val="old"/>
      <a name="width" val="1"/>
    </comp>
