  <circuit name="simple counter">
    <comp lib="1" loc="(140,280)" name="Clock"/>
    <comp lib="1" loc="(580,280)" name="Pin">
      <a name="facing" val="south"/>
      <a name="label" val="E12"/>
      <a name="labelloc" val="east"/>
      <a name="type" val="output"/>
    </comp>
    <comp lib="10" loc="(16,21)" name="Text">
      <a name="background" val="#f3ff214e"/>
      <a name="format" val="markdownish"/>
      <a name="text">Another demo circuit for the Alchitry Cu V2 with Io V2 hat.
A 4-bit counter can be displayed as a hex digit on any of the
four seven-segment displays. The left/right/up/center buttons
control which seven-segment digit(s) are enabled. All show the
same 4-bit hex digit. The down button enables the decimal point
of whichever digit(s) are enabled.
The extra button is used to increment the count.
For this demo, set the fpga clock to very slow speed, e.g. ~1hz,
otherwise the count button will go very very fast.</a>
      <a name="textwidth" val="550"/>
    </comp>
    <comp lib="5" loc="(200,240)" name="Counter">
      <a name="max" val="0xf"/>
      <a name="width" val="4"/>
    </comp>
    <comp lib="6" loc="(150,250)" name="Button">
      <a name="label" val="Count"/>
      <a name="labelloc" val="north"/>
    </comp>
    <comp lib="6" loc="(270,200)" name="Hex Digit Display">
      <a name="digits" val="4"/>
    </comp>
    <comp lib="6" loc="(340,370)" name="Button">
      <a name="label" val="L"/>
    </comp>
    <comp lib="6" loc="(370,320)" name="Button">
      <a name="facing" val="north"/>
      <a name="label" val="U"/>
    </comp>
    <comp lib="6" loc="(370,400)" name="Button">
      <a name="facing" val="north"/>
      <a name="label" val="D"/>
    </comp>
    <comp lib="6" loc="(380,370)" name="Button">
      <a name="label" val="C"/>
    </comp>
