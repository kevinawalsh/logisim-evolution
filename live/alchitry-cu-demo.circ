  <circuit name="HexDigitMultiplexer4">
    <a name="appearance" val="custom"/>
    <appear>
      <rect fill="none" height="20" stroke="#000000" stroke-width="2" width="134" x="50" y="50"/>
      <text dominant-baseline="top" font-family="SansSerif" font-size="12" text-anchor="middle" x="118" y="53">HexDigitMultiplexer4</text>
      <circ-port height="8" pin="180,210" width="8" x="76" y="66"/>
      <circ-port height="10" pin="300,150" width="10" x="75" y="45"/>
      <circ-port height="10" pin="370,190" width="10" x="105" y="45"/>
      <circ-port height="10" pin="390,210" width="10" x="115" y="45"/>
      <circ-port height="10" pin="410,230" width="10" x="125" y="45"/>
      <circ-port height="10" pin="430,250" width="10" x="135" y="45"/>
      <circ-port height="8" pin="120,340" width="8" x="166" y="66"/>
      <circ-anchor facing="east" height="6" width="6" x="77" y="47"/>
    </appear>
    <comp lib="1" loc="(120,340)" name="Pin">
      <a name="label" val="refresh_1ms"/>
    </comp>
    <comp lib="1" loc="(180,210)" name="Pin">
      <a name="label" val="Input"/>
      <a name="labelloc" val="north"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="1" loc="(190,360)" name="Clock">
      <a name="facing" val="north"/>
    </comp>
    <comp lib="1" loc="(200,210)" name="Splitter">
      <a name="bit1" val="0"/>
      <a name="bit10" val="2"/>
      <a name="bit11" val="2"/>
      <a name="bit12" val="3"/>
      <a name="bit13" val="3"/>
      <a name="bit14" val="3"/>
      <a name="bit15" val="3"/>
      <a name="bit2" val="0"/>
      <a name="bit3" val="0"/>
      <a name="bit4" val="1"/>
      <a name="bit5" val="1"/>
      <a name="bit6" val="1"/>
      <a name="bit7" val="1"/>
      <a name="bit8" val="2"/>
      <a name="bit9" val="2"/>
      <a name="fanout" val="4"/>
      <a name="incoming" val="16"/>
    </comp>
    <comp lib="1" loc="(300,150)" name="Pin">
      <a name="facing" val="south"/>
      <a name="label" val="MultiplexedNibble"/>
      <a name="labelloc" val="east"/>
      <a name="type" val="output"/>
      <a name="width" val="4"/>
    </comp>
    <comp lib="1" loc="(370,190)" name="Pin">
      <a name="facing" val="south"/>
      <a name="label" val="Digit_Enable_1"/>
      <a name="labelloc" val="east"/>
      <a name="type" val="output"/>
    </comp>
    <comp lib="1" loc="(390,210)" name="Pin">
      <a name="facing" val="south"/>
      <a name="label" val="Digit_Enable_2"/>
      <a name="labelloc" val="east"/>
      <a name="type" val="output"/>
    </comp>
    <comp lib="1" loc="(410,230)" name="Pin">
      <a name="facing" val="south"/>
      <a name="label" val="Digit_Enable_3"/>
      <a name="labelloc" val="east"/>
      <a name="type" val="output"/>
    </comp>
    <comp lib="1" loc="(430,250)" name="Pin">
      <a name="facing" val="south"/>
      <a name="label" val="Digit_Enable_4"/>
      <a name="labelloc" val="east"/>
      <a name="type" val="output"/>
    </comp>
    <comp lib="10" loc="(10,10)" name="Text">
      <a name="background" val="#2df7dc64"/>
      <a name="format" val="markdownish"/>
      <a name="text" val="HexDigitMultiplexer4 takes a 16-bit hex value and drives a 4-digit HexDisplay by multiplexing the nibbles. It relies on an external refresh pulse to drive the display at a reasonable rate. Using a Timed Pulse generator set to approx 1ms is ideal. Somewhat faster or slower rates should be fine as well, but very slow rates may lead to visible flicker."/>
      <a name="textwidth" val="507"/>
    </comp>
    <comp lib="10" loc="(250,360)" name="Callout">
      <a name="dx" val="-31"/>
      <a name="dy" val="-17"/>
      <a name="text" val="Counter cycles 0, 1, 2, 3, repeating forever."/>
    </comp>
    <comp lib="3" loc="(260,190)" name="Multiplexer">
      <a name="select" val="2"/>
      <a name="width" val="4"/>
    </comp>
    <comp lib="3" loc="(300,310)" name="Decoder">
      <a name="enable" val="false"/>
      <a name="select" val="2"/>
    </comp>
    <comp lib="5" loc="(210,330)" name="Counter">
      <a name="label" val="Counter"/>
      <a name="max" val="0x3"/>
      <a name="width" val="2"/>
    </comp>
    <wire from="(120,340)" to="(180,340)"/>
