  <circuit name="simple-io-demo">
    <comp lib="1" loc="(120,310)" name="Constant">
      <a name="radix" val="10unsigned"/>
      <a name="value" val="0x4"/>
      <a name="width" val="3"/>
    </comp>
    <comp lib="1" loc="(120,570)" name="Tunnel">
      <a name="facing" val="south"/>
      <a name="label" val="left"/>
    </comp>
    <comp lib="1" loc="(140,250)" name="Tunnel">
      <a name="facing" val="south"/>
      <a name="label" val="down"/>
    </comp>
    <comp lib="1" loc="(140,340)" name="Clock">
      <a name="facing" val="north"/>
    </comp>
    <comp lib="1" loc="(170,570)" name="Tunnel">
      <a name="facing" val="south"/>
      <a name="label" val="right"/>
    </comp>
    <comp lib="1" loc="(170,660)" name="Clock">
      <a name="facing" val="north"/>
    </comp>
    <comp lib="1" loc="(200,650)" name="Tunnel">
      <a name="label" val="rst"/>
    </comp>
    <comp lib="1" loc="(220,250)" name="Constant">
      <a name="facing" val="south"/>
      <a name="value" val="0x01"/>
      <a name="width" val="8"/>
    </comp>
    <comp lib="1" loc="(40,250)" name="Tunnel">
      <a name="facing" val="south"/>
      <a name="label" val="up"/>
    </comp>
    <comp lib="1" loc="(530,660)" name="Clock">
      <a name="facing" val="north"/>
    </comp>
    <comp lib="1" loc="(640,320)" name="Tunnel">
      <a name="label" val="center"/>
    </comp>
    <comp lib="1" loc="(650,240)" name="Tunnel">
      <a name="label" val="up"/>
    </comp>
    <comp lib="1" loc="(650,280)" name="Tunnel">
      <a name="label" val="left"/>
    </comp>
    <comp lib="1" loc="(650,360)" name="Tunnel">
      <a name="label" val="right"/>
    </comp>
    <comp lib="1" loc="(650,400)" name="Tunnel">
      <a name="label" val="down"/>
    </comp>
    <comp lib="1" loc="(770,300)" name="Tunnel">
      <a name="label" val="rst"/>
    </comp>
    <comp lib="1" loc="(90,250)" name="Tunnel">
      <a name="facing" val="south"/>
      <a name="label" val="center"/>
    </comp>
    <comp lib="10" loc="(20,20)" name="Text">
      <a name="background" val="#f3ff214e"/>
      <a name="format" val="wrapped"/>
      <a name="text">This circuit is meant to test all of the I/O features on the Alchitry Cu V2 fpga board with Io V2 hat, which has: a 4-digit seven segment display, six buttons (5 on the hat in a d-pad arrangement, and 1 more on the main fpga board), and 4x8 LEDs (3 bars of 8 on the hat, 1 bar of 8 on the main fpga board). The tiny DIP switches are used to control most of the LEDs.
For this demo, set the fpga clock speed to a few kHz or higher, anything fast should be fine.</a>
      <a name="textwidth" val="550"/>
      <a name="valign" val="base"/>
    </comp>
    <comp lib="10" loc="(290,342)" name="Text">
      <a name="foreground" val="#8914ff"/>
      <a name="halign" val="center"/>
      <a name="text">Map these to the Banks of LEDs
(3x8 on Io hat, 1x8 more on fpga board)</a>
      <a name="valign" val="base"/>
    </comp>
    <comp lib="10" loc="(30,170)" name="Text">
      <a name="background" val="#f003ff4e"/>
      <a name="text">Use the left/center/right D-Pad buttons to control
which LED is illuminated along the vertical bar,
and use the DIP switches to control the other LEDs.</a>
      <a name="valign" val="base"/>
    </comp>
    <comp lib="10" loc="(35,504)" name="Text">
      <a name="background" val="#f003ff4e"/>
      <a name="text">Use the up/down/reset
buttons to countrol the
value on the digit display.</a>
      <a name="valign" val="base"/>
    </comp>
    <comp lib="10" loc="(359,493)" name="Text">
      <a name="foreground" val="#8914ff"/>
      <a name="halign" val="center"/>
      <a name="text" val="Map this to the 4-gang 7segment display."/>
      <a name="valign" val="base"/>
    </comp>
    <comp lib="10" loc="(476,244)" name="Text">
      <a name="foreground" val="#8914ff"/>
      <a name="halign" val="center"/>
      <a name="text">Map these to the
D-Pad Buttons</a>
      <a name="valign" val="base"/>
    </comp>
    <comp lib="10" loc="(676,651)" name="Callout">
      <a name="dx" val="-121"/>
      <a name="dy" val="11"/>
      <a name="format" val="wrapped"/>
      <a name="halign" val="center"/>
      <a name="style" val="margin: 4px;"/>
      <a name="text" val="This generates a pulse every 1ms to drive the hex digit display refresh and button debounce circuits."/>
      <a name="valign" val="base"/>
    </comp>
    <comp lib="10" loc="(770,243)" name="Text">
      <a name="foreground" val="#8914ff"/>
      <a name="halign" val="center"/>
      <a name="text">Map this to
the reset button</a>
      <a name="valign" val="base"/>
    </comp>
    <comp lib="2" loc="(130,620)" name="OR Gate">
      <a name="facing" val="south"/>
      <a name="size" val="30"/>
    </comp>
    <comp lib="2" loc="(50,310)" name="OR Gate">
      <a name="facing" val="south"/>
      <a name="size" val="30"/>
    </comp>
    <comp lib="4" loc="(240,300)" name="Shifter">
      <a name="shift" val="rl"/>
    </comp>
    <comp lib="5" loc="(160,310)" name="Counter">
      <a name="max" val="0x7"/>
      <a name="width" val="3"/>
    </comp>
    <comp lib="5" loc="(190,620)" name="Counter">
      <a name="max" val="0xffff"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="6" loc="(140,420)" name="DipSwitch">
      <a name="label" val="DIPC"/>
      <a name="labelloc" val="south"/>
    </comp>
    <comp lib="6" loc="(150,410)" name="LEDBar">
      <a name="label" val="LEDC"/>
      <a name="labelloc" val="north"/>
    </comp>
    <comp lib="6" loc="(240,420)" name="DipSwitch">
      <a name="label" val="DIPD"/>
      <a name="labelloc" val="south"/>
    </comp>
    <comp lib="6" loc="(250,410)" name="LEDBar">
      <a name="label" val="LEDD"/>
      <a name="labelloc" val="north"/>
    </comp>
    <comp lib="6" loc="(310,310)" name="LEDBar">
      <a name="facing" val="north"/>
      <a name="inputtype" val="bus"/>
      <a name="label" val="LEDA"/>
      <a name="labelloc" val="north"/>
    </comp>
    <comp lib="6" loc="(330,570)" name="Hex Digit Display">
      <a name="digits" val="4"/>
      <a name="label" val="Hex"/>
      <a name="persist" val="40"/>
    </comp>
    <comp lib="6" loc="(40,420)" name="DipSwitch">
      <a name="label" val="DIPB"/>
      <a name="labelloc" val="south"/>
    </comp>
    <comp lib="6" loc="(460,350)" name="Button">
      <a name="label" val="L"/>
    </comp>
    <comp lib="6" loc="(490,300)" name="Button">
      <a name="facing" val="north"/>
      <a name="label" val="U"/>
    </comp>
    <comp lib="6" loc="(490,380)" name="Button">
      <a name="facing" val="north"/>
      <a name="label" val="D"/>
    </comp>
    <comp lib="6" loc="(50,410)" name="LEDBar">
      <a name="label" val="LEDB"/>
      <a name="labelloc" val="north"/>
    </comp>
    <comp lib="6" loc="(500,350)" name="Button">
      <a name="label" val="C"/>
    </comp>
    <comp lib="6" loc="(540,350)" name="Button">
      <a name="label" val="R"/>
    </comp>
    <comp lib="6" loc="(750,300)" name="Button">
      <a name="label" val="Reset"/>
      <a name="labelloc" val="north"/>
    </comp>
    <comp lib="9" loc="(540,640)" name="TimedPulse">
      <a name="interval" val="1.0"/>
      <a name="unit" val="ms"/>
    </comp>
    <comp loc="(330,580)" name="HexDigitMultiplexer4"/>
    <comp loc="(630,230)" name="debounce"/>
    <comp loc="(630,270)" name="debounce"/>
    <comp loc="(630,310)" name="debounce"/>
    <comp loc="(630,350)" name="debounce"/>
    <comp loc="(630,390)" name="debounce"/>
    <fpgaconfig board="Alchitry Cu V2 with Io (with LED Bars and 4Gang Seven Segment)">
      <clock mode="maximum"/>
      <map dest="4-digit Seven Segment Display 1x Left-Right 7Seg_x4" src="HexDigit Hex" type="SevenSegmentGang"/>
      <map dest="8-bit DIPSwitch 1x Right-Left DIP_A" src="DipSwitch DIPB" type="DIPSwitch"/>
      <map dest="8-bit DIPSwitch 1x Right-Left DIP_B" src="DipSwitch DIPC" type="DIPSwitch"/>
      <map dest="8-bit DIPSwitch 1x Right-Left DIP_C" src="DipSwitch DIPD" type="DIPSwitch"/>
      <map dest="8-bit LEDBar 1x Right-Left L17_24" src="LEDBar LEDB" type="LEDBar"/>
      <map dest="8-bit LEDBar 1x Right-Left L1_8" src="LEDBar LEDD" type="LEDBar"/>
      <map dest="8-bit LEDBar 1x Right-Left L9_16" src="LEDBar LEDC" type="LEDBar"/>
      <map dest="8-bit LEDBar 1x Top-Bottom LEDS" src="LEDBar LEDA" type="LEDBar"/>
      <map dest="Button DPAD_DOWN" src="Button D" type="Button"/>
      <map dest="Button DPAD_LEFT" src="Button L" type="Button"/>
      <map dest="Button DPAD_MIDDLE" src="Button C" type="Button"/>
      <map dest="Button DPAD_RIGHT" src="Button R" type="Button"/>
      <map dest="Button DPAD_UP" src="Button U" type="Button"/>
      <map dest="Button reset" src="Button Reset" type="Button"/>
    </fpgaconfig>
    <fpgaconfig board="Alchitry Cu V2 with Io (with LED Bars) (builtin)">
      <clock mode="maximum"/>
      <map dest="8-bit LEDBar 1x Right-Left L17_24" src="LEDBar LEDD" type="LEDBar"/>
      <map dest="8-bit LEDBar 1x Right-Left L1_8" src="LEDBar LEDB" type="LEDBar"/>
      <map dest="8-bit LEDBar 1x Right-Left L9_16" src="LEDBar LEDC" type="LEDBar"/>
      <map dest="8-bit LEDBar 1x Top-Bottom LEDS" src="OutputBus_LEDA" type="Ribbon"/>
      <map dest="Button DPAD_DOWN" src="Button D" type="Button"/>
      <map dest="Button DPAD_LEFT" src="Button L" type="Button"/>
      <map dest="Button DPAD_MIDDLE" src="Button C" type="Button"/>
      <map dest="Button DPAD_RIGHT" src="Button R" type="Button"/>
      <map dest="Button DPAD_UP" src="Button U" type="Button"/>
      <map dest="Button reset" src="Button Reset" type="Button"/>
      <map dest="LED DIGIT_0_ENABLE" src="Pin_3 of OutputBus_HexEnables" type="Pin"/>
      <map dest="LED DIGIT_1_ENABLE" src="Pin_2 of OutputBus_HexEnables" type="Pin"/>
      <map dest="LED DIGIT_2_ENABLE" src="Pin_1 of OutputBus_HexEnables" type="Pin"/>
      <map dest="LED DIGIT_3_ENABLE" src="Pin_0 of OutputBus_HexEnables" type="Pin"/>
      <map dest="SevenSegment 7Seg_x4" src="HexDigit Hex" type="SevenSegment"/>
    </fpgaconfig>
    <fpgaconfig board="Alchitry Cu V2 with Io">
      <clock mode="reduced" period="3750"/>
      <map dest="4-digit Seven Segment Display 1x Left-Right 7Seg_x4" src="HexDigit Hex" type="SevenSegmentGang"/>
      <map dest="8-bit DIPSwitch 1x Right-Left DIP_A" src="DipSwitch DIPB" type="DIPSwitch"/>
      <map dest="8-bit DIPSwitch 1x Right-Left DIP_B" src="DipSwitch DIPC" type="DIPSwitch"/>
      <map dest="8-bit DIPSwitch 1x Right-Left DIP_C" src="DipSwitch DIPD" type="DIPSwitch"/>
      <map dest="8-bit LEDBar 1x Right-Left L17_24" src="LEDBar LEDB" type="LEDBar"/>
      <map dest="8-bit LEDBar 1x Right-Left L1_8" src="LEDBar LEDD" type="LEDBar"/>
      <map dest="8-bit LEDBar 1x Right-Left L9_16" src="LEDBar LEDC" type="LEDBar"/>
      <map dest="8-bit LEDBar 1x Top-Bottom LEDS" src="LEDBar LEDA" type="LEDBar"/>
      <map dest="Button DPAD_DOWN" src="Button D" type="Button"/>
      <map dest="Button DPAD_LEFT" src="Button L" type="Button"/>
      <map dest="Button DPAD_MIDDLE" src="Button C" type="Button"/>
      <map dest="Button DPAD_RIGHT" src="Button R" type="Button"/>
      <map dest="Button DPAD_UP" src="Button U" type="Button"/>
      <map dest="Button reset" src="Button Reset" type="Button"/>
    </fpgaconfig>
