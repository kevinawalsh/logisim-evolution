      <map dest="4-digit Seven Segment Display 1x Left-Right 7Seg_x4" src="SevenSegment at (230,210)" type="SevenSegmentGang"/>
      <map dest="8-bit LEDBar 1x Right-Left L17_24" src="LEDBar left" type="LEDBar"/>
      <map dest="8-bit LEDBar 1x Right-Left L1_8" src="LEDBar right" type="LEDBar"/>
      <map dest="8-bit LEDBar 1x Right-Left L9_16" src="LEDBar middle" type="LEDBar"/>
      <map dest="Button DPAD_DOWN" src="Button S" type="Button"/>
      <map dest="Button DPAD_LEFT" src="Button A" type="Button"/>
      <map dest="Button DPAD_RIGHT" src="Button D" type="Button"/>
      <map dest="Button DPAD_UP" src="Button W" type="Button"/>
      <map dest="Button reset" src="Button R" type="Button"/>
    </fpgaconfig>
