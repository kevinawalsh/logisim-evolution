  <circuit name="demo-realtime-clock">
    <comp lib="0" loc="(101,268)" name="Callout">
      <a name="dx" val="24"/>
      <a name="dy" val="-93"/>
      <a name="foreground" val="#d15c5a"/>
      <a name="text" val="Actual date &amp; time"/>
    </comp>
    <comp lib="0" loc="(17,22)" name="Text">
      <a name="halign" val="left"/>
      <a name="text">Demonstration of the external "real time clock". These give you access to the current date
and time (i.e. the number of seconds since the computer epoch began, midnight jan 1, 1970).
Or you can access the "uptime", the amout of time since the simulation began or was reset.

Using 32 bits means these won't overflow for a while yet. If you choose a narrower bit-width,
it will overflow (and wrap around) quicker.</a>
    </comp>
    <comp lib="0" loc="(374,430)" name="Callout">
      <a name="dx" val="-52"/>
      <a name="dy" val="-55"/>
      <a name="foreground" val="#d15c5a"/>
      <a name="text">Nanoseconds!!
go quick, 1 billion per second.
At 32 bits, this will overflow 
in 4 seconds.</a>
    </comp>
    <comp lib="0" loc="(448,176)" name="Callout">
      <a name="dx" val="-66"/>
      <a name="dy" val="-8"/>
      <a name="foreground" val="#d15c5a"/>
      <a name="text">Time since the
simulation was
last reset.</a>
    </comp>
    <comp lib="1" loc="(280,170)" name="Clock">
      <a name="facing" val="north"/>
    </comp>
    <comp lib="1" loc="(280,240)" name="Clock">
      <a name="facing" val="north"/>
    </comp>
    <comp lib="1" loc="(280,310)" name="Clock">
      <a name="facing" val="north"/>
    </comp>
    <comp lib="1" loc="(280,380)" name="Clock">
      <a name="facing" val="north"/>
    </comp>
