  <circuit name="demo-usb-arduino">
    <a name="appearance" val="classic"/>
    <comp lib="0" loc="(310,247)" name="Callout">
      <a name="background" val="#feffa189"/>
      <a name="dx" val="-33"/>
      <a name="dy" val="-10"/>
      <a name="foreground" val="#cc45bf"/>
      <a name="halign" val="left"/>
      <a name="text">Arduino's x-axis accelerometer is
used to control sawtooth frequency.</a>
    </comp>
    <comp lib="0" loc="(57,167)" name="Callout">
      <a name="background" val="#feffa189"/>
      <a name="dx" val="57"/>
      <a name="dy" val="113"/>
      <a name="foreground" val="#cc45bf"/>
      <a name="halign" val="left"/>
      <a name="text">Connect arduino
to usb, then poke
to connect.</a>
    </comp>
    <comp lib="1" loc="(220,380)" name="Probe">
      <a name="facing" val="north"/>
      <a name="label" val="X"/>
      <a name="labelloc" val="south"/>
      <a name="radix" val="10unsigned"/>
    </comp>
    <comp lib="1" loc="(270,380)" name="Probe">
      <a name="facing" val="north"/>
      <a name="label" val="Y"/>
      <a name="labelloc" val="south"/>
      <a name="radix" val="10unsigned"/>
    </comp>
    <comp lib="1" loc="(320,380)" name="Probe">
      <a name="facing" val="north"/>
      <a name="label" val="Z"/>
      <a name="labelloc" val="south"/>
      <a name="radix" val="10unsigned"/>
    </comp>
    <comp lib="1" loc="(370,190)" name="Clock">
      <a name="facing" val="north"/>
    </comp>
    <comp lib="1" loc="(370,380)" name="Probe">
      <a name="facing" val="north"/>
      <a name="label" val="x"/>
      <a name="labelloc" val="south"/>
      <a name="radix" val="10unsigned"/>
    </comp>
    <comp lib="1" loc="(420,160)" name="Clock">
      <a name="facing" val="north"/>
    </comp>
    <comp lib="1" loc="(420,380)" name="Probe">
      <a name="facing" val="north"/>
      <a name="label" val="y"/>
      <a name="labelloc" val="south"/>
      <a name="radix" val="10unsigned"/>
    </comp>
    <comp lib="1" loc="(470,380)" name="Probe">
      <a name="facing" val="north"/>
      <a name="label" val="z"/>
      <a name="labelloc" val="south"/>
      <a name="radix" val="10unsigned"/>
    </comp>
    <comp lib="1" loc="(520,380)" name="Probe">
      <a name="facing" val="north"/>
      <a name="label" val="dial"/>
      <a name="labelloc" val="south"/>
      <a name="radix" val="10unsigned"/>
    </comp>
    <comp lib="1" loc="(580,380)" name="Probe">
      <a name="facing" val="north"/>
      <a name="label" val="temperature"/>
      <a name="labelloc" val="south"/>
      <a name="radix" val="10unsigned"/>
    </comp>
    <comp lib="10" loc="(140,350)" name="SerialIn">
      <a name="format">[\n\r]
%8u %8u %8u %8u %8u %8u %8u %8u</a>
      <a name="port" val="/dev/ttyACM0"/>
    </comp>
    <comp lib="6" loc="(400,130)" name="Scope">
      <a name="color" val="#6fff0e"/>
      <a name="mode" val="twosComplement"/>
      <a name="offcolor" val="#878787"/>
      <a name="scopeheight" val="80"/>
      <a name="scopewidth" val="240"/>
      <a name="width" val="16"/>
