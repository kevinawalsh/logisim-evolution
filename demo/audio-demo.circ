    <comp lib="0" loc="(245,212)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="x[n]"/>
    </comp>
    <comp lib="0" loc="(277,372)" name="Callout">
      <a name="background" val="#feffa189"/>
      <a name="dx" val="29"/>
      <a name="dy" val="-54"/>
      <a name="foreground" val="#cc45bf"/>
      <a name="halign" val="left"/>
      <a name="text">The trick I'm using here is to use a sawtooth to
sweep through numbers at the desired
frequency. Whenever the sawtooth crosses the 
centerline, going from x[n-1]&lt;1 during the last
clock tickk, to x[n]&gt;0 during this tick, we output a 1.</a>
    </comp>
    <comp lib="0" loc="(56,44)" name="Text">
      <a name="halign" val="left"/>
      <a name="text">click-track generator - This outputs a "0" normally, with regularly spaced short "1" pulses.
The freequency is controlled by an input.</a>
    </comp>
    <comp lib="1" loc="(100,260)" name="Pin">
      <a name="label" val="Freq"/>
      <a name="radix" val="10unsigned"/>
      <a name="width" val="12"/>
    </comp>
    <comp lib="1" loc="(250,330)" name="Clock">
      <a name="facing" val="north"/>
    </comp>
    <comp lib="1" loc="(310,240)" name="Constant">
