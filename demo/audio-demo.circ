  <circuit name="squarewave-alternate">
    <a name="appearance" val="custom"/>
    <appear>
      <rect fill="none" height="60" stroke="#000000" stroke-width="2" width="80" x="50" y="50"/>
      <text dominant-baseline="central" font-family="SansSerif" font-size="10" text-anchor="middle" x="100" y="103">Duty</text>
      <text dominant-baseline="central" font-family="SansSerif" font-size="12" text-anchor="middle" x="90" y="68">squarewave</text>
      <polyline fill="none" points="106,76 106,96" stroke="#000000"/>
      <polyline fill="none" points="86,76 86,96" stroke="#000000"/>
      <polyline fill="none" points="106,76 116,76" stroke="#000000"/>
      <polyline fill="none" points="60,96 65,96" stroke="#000000"/>
      <polyline fill="none" points="66,96 66,77" stroke="#000000"/>
      <polyline fill="none" points="66,76 86,76" stroke="#000000"/>
      <polyline fill="none" points="86,96 105,96" stroke="#000000"/>
      <visible-probe height="10" path="/sawtooth(230,220)/Probe(100,450)" stroke-width="0" width="53" x="44" y="99"/>
      <polyline fill="none" points="59,86 118,86" stroke="#d1d1d1"/>
      <visible-rgbled height="10" path="/sawtooth(230,220)/RGBLED(150,340)" stroke-width="0" width="10" x="55" y="52"/>
      <circ-port height="10" pin="410,170" width="10" x="125" y="85"/>
      <circ-port height="8" pin="120,320" width="8" x="96" y="106"/>
      <circ-port height="8" pin="120,180" width="8" x="46" y="56"/>
      <circ-port height="8" pin="150,260" width="8" x="66" y="106"/>
      <circ-port height="8" pin="120,210" width="8" x="46" y="66"/>
      <circ-anchor facing="east" height="6" width="6" x="127" y="87"/>
    </appear>
    <comp lib="0" loc="(38,38)" name="Text">
      <a name="halign" val="left"/>
      <a name="text">flexible square wave generator - When enabled, alternates between -10000 and +10000 (with
no values between them), forever.
You can choose any frequency from 1Hz to 4096Hz. And another input determines
the "duty cycle" (from 0 to 127), controlling how long the "up" part of the square wave lasts.</a>
    </comp>
    <comp lib="0" loc="(400,250)" name="Callout">
      <a name="background" val="#feffa189"/>
      <a name="dx" val="-55"/>
      <a name="dy" val="3"/>
      <a name="foreground" val="#cc45bf"/>
      <a name="halign" val="left"/>
      <a name="text">The trick I'm using here is to use a sawtooth to
sweep through numbers -10000 to +10000 at the desired
frequency. I then take that result and
compare it to a threshold.
Whenever the sawtooth is above the 
threshold, the multiplexer picks -10000 to
send to the audio output. And when
the sawtooth is below (or equal) to
the threshold, it picks +10000 to send to the output.

Using duty=0 gives a threshold of -10000
using a duty of 128 gives a threshold of +10000</a>
    </comp>
    <comp lib="0" loc="(50,425)" name="Callout">
      <a name="dx" val="131"/>
      <a name="dy" val="-66"/>
      <a name="foreground" val="#cc45bf"/>
      <a name="halign" val="left"/>
      <a name="text">This part of the circuit converts a number in
the range [0, 127] first to a 16 bit number, then
subtracts 64, then multiplies by 158, to get
a value in the range approx [-10000, +10000]</a>
    </comp>
    <comp lib="1" loc="(120,180)" name="Pin">
      <a name="behavior" val="pullup"/>
      <a name="label" val="Enable"/>
    </comp>
    <comp lib="1" loc="(120,210)" name="Pin">
      <a name="behavior" val="pulldown"/>
      <a name="label" val="Reset"/>
    </comp>
    <comp lib="1" loc="(120,320)" name="Pin">
      <a name="label" val="DutyCycle"/>
      <a name="radix" val="10unsigned"/>
      <a name="width" val="7"/>
    </comp>
    <comp lib="1" loc="(150,260)" name="Pin">
      <a name="label" val="Freq"/>
      <a name="radix" val="10unsigned"/>
      <a name="width" val="12"/>
    </comp>
    <comp lib="1" loc="(210,340)" name="Constant">
      <a name="radix" val="10signed"/>
      <a name="value" val="0x0040"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="1" loc="(250,360)" name="Constant">
      <a name="radix" val="10signed"/>
      <a name="value" val="0x009e"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="1" loc="(330,160)" name="Constant">
      <a name="radix" val="10signed"/>
      <a name="value" val="0x2710"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="1" loc="(330,180)" name="Constant">
      <a name="radix" val="10signed"/>
      <a name="value" val="0xd8f0"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="1" loc="(410,170)" name="Pin">
      <a name="facing" val="west"/>
      <a name="label" val="AudioSignal"/>
      <a name="labelloc" val="east"/>
      <a name="type" val="output"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="3" loc="(370,170)" name="Multiplexer">
      <a name="enable" val="false"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="4" loc="(330,230)" name="Comparator">
      <a name="mode" val="unsigned"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="8" loc="(170,320)" name="FitRange">
      <a name="normalization" val="cap"/>
      <a name="widthIn" val="7"/>
      <a name="widthOut" val="16"/>
    </comp>
    <comp lib="8" loc="(250,330)" name="SaturatingSubtractor">
      <a name="mode" val="twosComplement"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="8" loc="(300,340)" name="SaturatingMultiplier">
      <a name="mode" val="twosComplement"/>
      <a name="width" val="16"/>
    </comp>
    <comp loc="(230,220)" name="sawtooth"/>
    <wire from="(120,180)" to="(130,180)"/>
    <wire from="(120,210)" to="(130,210)"/>
    <wire from="(120,320)" to="(140,320)"/>
    <wire from="(130,180)" to="(130,190)"/>
    <wire from="(130,190)" to="(150,190)"/>
    <wire from="(130,200)" to="(130,210)"/>
    <wire from="(130,200)" to="(150,200)"/>
    <wire from="(150,260)" to="(170,260)"/>
    <wire from="(170,240)" to="(170,260)"/>
    <wire from="(170,320)" to="(220,320)"/>
