    </comp>
    <comp lib="1" loc="(310,280)" name="Constant">
      <a name="radix" val="10unsigned"/>
      <a name="value" val="0x0001"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="1" loc="(480,210)" name="Clock">
      <a name="facing" val="north"/>
    </comp>
    <comp lib="1" loc="(480,260)" name="Pin">
      <a name="facing" val="west"/>
      <a name="label" val="click"/>
      <a name="labelloc" val="east"/>
      <a name="type" val="output"/>
    </comp>
    <comp lib="1" loc="(570,180)" name="Pin">
      <a name="facing" val="west"/>
      <a name="label" val="count"/>
      <a name="labelloc" val="east"/>
      <a name="radix" val="10unsigned"/>
      <a name="type" val="output"/>
      <a name="width" val="16"/>
    </comp>
    <comp lib="1" loc="(80,190)" name="Pin">
      <a name="behavior" val="pullup"/>
      <a name="label" val="Enable"/>
    </comp>
    <comp lib="2" loc="(430,260)" name="AND Gate"/>
    <comp lib="4" loc="(360,230)" name="Comparator">
      <a name="width" val="16"/>
    </comp>
