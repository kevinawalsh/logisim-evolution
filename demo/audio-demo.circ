      <a name="typeIn" val="twosComplement"/>
      <a name="widthIn" val="32"/>
      <a name="widthOut" val="16"/>
    </comp>
    <wire from="(140,440)" to="(280,440)"/>
    <wire from="(170,490)" to="(170,570)"/>
    <wire from="(170,490)" to="(190,490)"/>
    <wire from="(170,570)" to="(470,570)"/>
