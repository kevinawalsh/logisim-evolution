      <a name="color" val="#9de2dc"/>
      <a name="facing" val="west"/>
      <a name="width" val="12"/>
    </comp>
    <comp lib="6" loc="(160,270)" name="Button">
      <a name="behavior" val="latching"/>
      <a name="color" val="#ff4c91"/>
      <a name="label" val="A"/>
    </comp>
    <comp lib="6" loc="(160,360)" name="Button">
      <a name="behavior" val="latching"/>
      <a name="color" val="#ff4c91"/>
      <a name="label" val="B"/>
    </comp>
    <comp lib="6" loc="(410,270)" name="Scope">
