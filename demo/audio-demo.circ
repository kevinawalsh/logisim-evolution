      <a name="type" val="zero"/>
    </comp>
    <comp lib="1" loc="(150,540)" name="Constant">
      <a name="radix" val="10unsigned"/>
      <a name="value" val="0x00041893"/>
      <a name="width" val="32"/>
    </comp>
    <comp lib="1" loc="(220,340)" name="Clock">
      <a name="facing" val="north"/>
    </comp>
    <comp lib="1" loc="(250,510)" name="Tunnel">
      <a name="facing" val="south"/>
