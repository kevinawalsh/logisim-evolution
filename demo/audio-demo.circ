  <circuit name="sawtooth-80hz">
    <a name="appearance" val="custom"/>
    <appear>
      <rect fill="none" height="56" stroke="#000000" stroke-width="2" width="80" x="50" y="54"/>
      <text dominant-baseline="central" font-family="SansSerif" font-size="9" text-anchor="middle" x="74" y="103">79.6Hz</text>
      <text dominant-baseline="central" font-family="SansSerif" font-size="12" text-anchor="middle" x="89" y="69">sawtooth</text>
      <visible-rgbled height="10" path="/RGBLED(170,310)" stroke-width="0" width="10" x="53" y="56"/>
      <polyline fill="none" points="54,86 120,86" stroke="#dbdbdb"/>
      <polyline fill="none" points="78,77 78,97" stroke="#000000"/>
      <polyline fill="none" points="78,97 98,77" stroke="#000000"/>
